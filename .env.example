# Скопіюйте цей файл у .env і впишіть свої значення.
# Файл .env НЕ потрапляє в git (він у .gitignore).

# Токен вашого Telegram-бота (отримати у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ID чатів/користувачів через кому, кому надсилати сповіщення
TELEGRAM_CHAT_IDS=123456789,987654321

# Посилання на видачу OLX з вашими фільтрами (необов'язково)
OLX_SEARCH_URL=https://www.olx.ua/uk/nedvizhimost/kvartiry/dolgosrochnaya-arenda-kvartir/kiev/?currency=UAH&search%5Border%5D=created_at:desc
